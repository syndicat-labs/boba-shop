# Production environment template. Copy to .env.prod and fill in. Never commit .env.prod.

# --- Django / security ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated public hostname(s), e.g. boba.example.com
ALLOWED_HOSTS=
# Set 1 when TLS is terminated at the edge (cloudflared tunnel / LB). Required for secure cookies.
TRUST_PROXY=1
# Comma-separated origins allowed to POST via CSRF, e.g. https://boba.example.com
CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL ---
POSTGRES_DB=boba
POSTGRES_USER=boba
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (channel layer) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Payments ---
# Real PSP adapter id (paystack/flutterwave/etc). "mock" is FORBIDDEN in prod.
PSP_ACTIVE=
DEV_MOCK_PSP=0
DEV_MOCK_FEED=0

# --- Receipt storage (S3-compatible) ---
AWS_S3_ENDPOINT_URL=
AWS_STORAGE_BUCKET_NAME=boba-receipts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
